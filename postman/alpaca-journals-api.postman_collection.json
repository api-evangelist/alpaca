                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"entry_type\": \"JNLC\",\n  \"from_account\": \"<uuid>\",\n  \"entries\": [\n    {\n      \"to_account\": \"<uuid>\",\n      \"amount\": \"<string>\"\n    }\n  ],\n  \"description\": \"<string>\"\n}",
