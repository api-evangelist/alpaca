                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "top",
                  "value": "10",
                  "description": "Number of top market movers to fetch (gainers and losers). Will return number top for each. By default 10 gainers and 10 losers."
