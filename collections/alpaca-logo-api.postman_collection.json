          "name": "Get Logo for symbol",
          "request": {
            "name": "Get Logo for symbol",
            "description": {
              "content": "Returns logo image resource for provided symbol.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1beta1",
                "logos",
                ":crypto_or_stock_symbol"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "placeholder",
                  "value": "true",
                  "description": "If true then the api will generate a placeholder image if no logo was found. Defaults to true"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "crypto_or_stock_symbol",
                  "description": "(Required) The crypto or stock symbol to query for. Note, currently all crypto symbols must be appended with \"USD\", ie \"BTCUSD\" would be how you query for BTC."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/*"
              }
            ],
            "method": "GET",
            "auth": null
