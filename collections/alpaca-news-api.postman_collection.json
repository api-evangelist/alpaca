      "item": [
        {
          "id": "cbb6a234-3c12-4a1f-9d0b-60d159a8818d",
          "name": "News API",
          "request": {
            "name": "News API",
            "description": {
              "content": "Returns latest news articles across stocks and crypto. By default returns latest 10 news articles.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1beta1",
                "news"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "Filter data equal to or after this time in RFC-3339 format. Fractions of a second are not accepted."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "Filter data equal to or before this time in RFC-3339 format. Fractions of a second are not accepted."
                },
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "(Required) The comma-separated list of crypto symbols to query for. Note, currently all crypto symbols must be appended with \"USD\", ie \"BTCUSD,ETHUSD\" would get both BTC and ETH"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of data points to return. Must be in range 1-10000, defaults to 1000."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort articles by updated date. Options: DESC, ASC"
                },
                {
                  "disabled": false,
                  "key": "include_content",
                  "value": "<boolean>",
                  "description": "Boolean indicator to include content for news articles (if available)"
                },
                {
                  "disabled": false,
                  "key": "exclude_contentless",
                  "value": "<boolean>",
                  "description": "Boolean indicator to exclude news articles that do not contain content "
                },
                {
                  "disabled": false,
                  "key": "page_token",
                  "value": "<string>",
                  "description": "Pagination token to continue from. The value to pass here is returned in specific requests when more data is available than the request limit allows."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "bb6810ec-fc1f-47eb-b4a7-fe141e0c76e0",
              "name": "Successful response",
