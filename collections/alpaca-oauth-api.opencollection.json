{
  "opencollection": "1.0.0",
  "info": {
    "name": "Broker Account Activities OAuth API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OAuth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an OAuth client",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://broker-api.sandbox.alpaca.markets/v1/oauth/clients/:client_id",
            "params": [
              {
                "name": "client_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "response_type",
                "value": "",
                "type": "query",
                "description": "code or token"
              },
              {
                "name": "redirect_uri",
                "value": "",
                "type": "query",
                "description": "Redirect URI of the OAuth flow"
              },
              {
                "name": "scope",
                "value": "",
                "type": "query",
                "description": "Requested scopes by the OAuth flow"
              }
            ]
          },
          "docs": "The endpoint returns the details of OAuth client to display in the authorization page.\n"
        },
        {
          "info": {
            "name": "Issue an OAuth token.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://broker-api.sandbox.alpaca.markets/v1/oauth/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "The operation issues an OAuth code which can be used in the OAuth code flow.\n"
        },
        {
          "info": {
            "name": "Authorize an OAuth Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://broker-api.sandbox.alpaca.markets/v1/oauth/authorize",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "The operation issues an OAuth code which can be used in the OAuth code flow.\n"
        }
      ]
    }
  ],
  "bundled": true
}